# Copy this file to .env (which is gitignored) and fill in what you need.

# Optional: your ESPN league ID. You can also enter it on the ESPN league page in the app.
ESPN_LEAGUE_ID=

# Only needed for PRIVATE ESPN leagues. These are login cookies, so treat them like a password.
# How to get them: log in at fantasy.espn.com in Chrome or Edge, press F12, go to
# Application > Cookies > https://fantasy.espn.com, and copy the values of espn_s2 and SWID.
ESPN_S2=
ESPN_SWID=

# How long downloaded data stays fresh before re-downloading (hours).
CACHE_TTL_HOURS=12

# Prior seasons loaded alongside the current one for projections.
HISTORY_SEASONS=2
